rules_version = '2';
// Firestore rules for SVL Costing Web.
//
// OWNER: replace YOUR_EMAIL@gmail.com with the owner's Google email (lowercase) when publishing in the Firebase console. Owners are always admins,
// so they can never lock themselves out. Everybody else is managed in the app:
//   Cài đặt → Người dùng & phân quyền  (stored in svl_costing_config/access)
// Roles: admin (everything + manage users) · editor (import, run steps, edit) · viewer (read only).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isOwner() {
      return signedIn() && myEmail() in ['YOUR_EMAIL@gmail.com'];
    }
    function accessPath() {
      return /databases/$(database)/documents/svl_costing_config/access;
    }
    function hasRole(r) {
      return signedIn() && exists(accessPath())
        && get(accessPath()).data.members.get(myEmail(), '') == r;
    }
    function isAdmin()  { return isOwner() || hasRole('admin'); }
    function canWrite() { return isAdmin() || hasRole('editor'); }
    function canRead()  { return canWrite() || hasRole('viewer'); }

    match /svl_costing_config/access {
      allow read: if canRead();
      allow write: if isAdmin();
    }
    // Closed periods (summary.closed set): only admins may change anything, and only admins may close / reopen.
    function closedOf(d) { return d.get('summary', {}).get('closed', null); }
    function periodPath(p) { return /databases/$(database)/documents/svl_costing_periods/$(p); }
    function periodOpen(p) { return !exists(periodPath(p)) || closedOf(get(periodPath(p)).data) == null; }
    // Periods: optimistic revisioning. CLOSED periods are immutable until an explicit admin REOPEN revision.
    match /svl_costing_periods/{period} {
      allow read: if canRead();
      allow create: if canWrite() && request.resource.data.rev == 1
        && (isAdmin() || closedOf(request.resource.data) == null);
      allow update: if canWrite() && request.resource.data.rev == resource.data.get('rev', 0) + 1
        && (
          // Normal OPEN-period work. Editors and admins may save, but the period stays OPEN.
          (closedOf(resource.data) == null && closedOf(request.resource.data) == null)
          ||
          // Explicit CLOSE: admin only, OPEN → CLOSED. The close revision may legitimately change
          // closed/closedEver/rwArchive/audit blobs and the calculated period summary.
          (isAdmin() && closedOf(resource.data) == null && closedOf(request.resource.data) != null)
          ||
          // Explicit REOPEN: admin only, CLOSED → OPEN. The accounting blobs remain immutable except
          // removing the active 'closed' blob. summary.step5 changes from CLOSED back to the live gate,
          // so it must be allowed together with closed/everClosed.
          (isAdmin() && closedOf(resource.data) != null && closedOf(request.resource.data) == null
            && request.resource.data.blobs.diff(resource.data.blobs).affectedKeys().hasOnly(['closed'])
            && request.resource.data.summary.diff(resource.data.summary).affectedKeys().hasOnly(['closed', 'everClosed', 'step5'])
            && request.resource.data.summary.get('everClosed', false) == true)
        );
      // A period that has ever been CLOSED is an accounting record and may not be hard-deleted.
      allow delete: if isAdmin() && closedOf(resource.data) == null
        && resource.data.get('summary', {}).get('everClosed', false) != true;
      match /chunks/{chunk} {
        allow read: if canRead();
        // Content-addressed accounting chunks are immutable: create while OPEN, never update in place.
        allow create: if canWrite() && periodOpen(period);
        allow update: if false;
        allow delete: if isAdmin() && periodOpen(period);
      }
      // Immutable manifest snapshot for every committed cloud revision.
      match /revisions/{revision} {
        allow read: if canRead();
        allow create: if canWrite() && request.resource.data.by == myEmail()
          && request.resource.data.period == period
          && request.resource.data.rev == getAfter(periodPath(period)).data.rev
          && request.resource.data.previousRev == request.resource.data.rev - 1
          && request.resource.data.manifestHash == getAfter(periodPath(period)).data.manifestHash
          && request.resource.data.blobs == getAfter(periodPath(period)).data.blobs
          && request.resource.data.summary == getAfter(periodPath(period)).data.summary;
        allow update, delete: if false;
      }
      // v1.14.41 (maker–checker, STEP 5R manual unit cost): one receipt per line. Any editor may request, and the request
      // is stamped with the signed-in requester. Only a DIFFERENT signed-in user may approve, and an approval may not change
      // the requested values. The requester or an admin may delete. Closed periods are immutable.
      match /approvals/{approval} {
        function requestOk() {
          return request.resource.data.status == 'REQUESTED'
            && request.resource.data.requestedByEmail == myEmail()
            && request.resource.data.requestedByUid == request.auth.uid
            && request.resource.data.get('approvedByEmail', '') == '';
        }
        allow read: if canRead();
        allow create: if canWrite() && periodOpen(period) && requestOk();
        allow update: if canWrite() && periodOpen(period) && (
          requestOk()
          ||
          (resource.data.status == 'REQUESTED'
            && request.resource.data.status == 'APPROVED'
            && request.resource.data.requestedByEmail == resource.data.requestedByEmail
            && request.resource.data.requestedByUid == resource.data.requestedByUid
            && request.resource.data.canonical == resource.data.canonical
            && request.resource.data.values == resource.data.values
            && request.resource.data.approvedByEmail == myEmail()
            && request.resource.data.approvedByUid == request.auth.uid
            && myEmail() != resource.data.requestedByEmail)
        );
        allow delete: if canWrite() && periodOpen(period) && (resource.data.requestedByEmail == myEmail() || isAdmin());
      }
    }
    // Notification events are immutable and committed atomically with the period revision.
    // Every reader must already be authorized to access the accounting application.
    match /svl_costing_notifications/{id} {
      allow read: if canRead();
      allow create: if canWrite()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actor == myEmail()
        && request.resource.data.period is string
        && request.resource.data.rev is int
        && request.resource.data.rev > 0
        && request.resource.data.kind in ['info', 'warning', 'critical']
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 160
        && request.resource.data.detail is string
        && request.resource.data.detail.size() <= 500
        && request.resource.data.period.matches('^[0-9]{4}-[0-9]{2}$')
        && getAfter(periodPath(request.resource.data.period)).data.rev == request.resource.data.rev
        && getAfter(periodPath(request.resource.data.period)).data.updatedBy == request.auth.token.email
        && getAfter(periodPath(request.resource.data.period)).data.updatedAt == request.resource.data.clientAt;
      allow update, delete: if false;
    }
    // Read/unread state is private to its owner, across the owner's devices.
    match /svl_costing_notification_reads/{uid} {
      allow read: if canRead() && request.auth.uid == uid;
      allow create, update: if canRead() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'seen', 'readThrough', 'updatedAt'])
        && request.resource.data.get('seen', []) is list
        && request.resource.data.get('seen', []).size() <= 180;
      allow delete: if false;
    }

    // Append-only audit trail: anyone who can write data can add own events; nobody can change or delete them.
    match /svl_costing_audit/{id} {
      allow read: if canRead();
      // v1.14.35 (ENH-08): an ACTOR event must name the signed-in uid and email that performed it; UNVERIFIED events are uploaded by the signed-in user.
      allow create: if canWrite() && request.resource.data.by == myEmail()
        && (request.resource.data.get('attribution', 'LEGACY') != 'ACTOR' || (request.resource.data.actorUid == request.auth.uid && request.resource.data.actorEmail == myEmail()));
      allow update, delete: if false;
    }
  }
}
