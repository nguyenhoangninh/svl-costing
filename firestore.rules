rules_version = '2';
// Firestore rules for SVL Costing Web.
//
// OWNER: replace YOUR_EMAIL@gmail.com with the owner's Google email (lowercase). Owners are always admins,
// so they can never lock themselves out. Everybody else is managed in the app:
//   Cài đặt → Người dùng & phân quyền  (stored in svl_costing_config/access)
// Roles: admin (everything + manage users) · editor (import, run steps, edit) · viewer (read only).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isOwner() {
      return signedIn() && myEmail() in ['YOUR_EMAIL@gmail.com'];
    }
    function accessPath() {
      return /databases/$(database)/documents/svl_costing_config/access;
    }
    function hasRole(r) {
      return signedIn() && exists(accessPath())
        && get(accessPath()).data.members.get(myEmail(), '') == r;
    }
    function isAdmin()  { return isOwner() || hasRole('admin'); }
    function canWrite() { return isAdmin() || hasRole('editor'); }
    function canRead()  { return canWrite() || hasRole('viewer'); }

    match /svl_costing_config/access {
      allow read: if canRead();
      allow write: if isAdmin();
    }
    // Closed periods (summary.closed set): only admins may change anything, and only admins may close / reopen.
    function closedOf(d) { return d.get('summary', {}).get('closed', null); }
    function periodPath(p) { return /databases/$(database)/documents/svl_costing_periods/$(p); }
    function periodOpen(p) { return !exists(periodPath(p)) || closedOf(get(periodPath(p)).data) == null; }
    // Periods: optimistic revisioning. CLOSED periods are immutable until an explicit admin REOPEN revision.
    match /svl_costing_periods/{period} {
      allow read: if canRead();
      allow create: if canWrite() && request.resource.data.rev == 1
        && (isAdmin() || closedOf(request.resource.data) == null);
      allow update: if canWrite() && request.resource.data.rev == resource.data.get('rev', 0) + 1
        && (
          // Normal work while the existing period is open. Editors cannot close a period.
          (closedOf(resource.data) == null && (isAdmin() || closedOf(request.resource.data) == null))
          ||
          // Explicit REOPEN: admin only, CLOSED → open, and the only manifest change is the closed-state blob.
          (isAdmin() && closedOf(resource.data) != null && closedOf(request.resource.data) == null
            && request.resource.data.blobs.diff(resource.data.blobs).affectedKeys().hasOnly(['closed'])
            && request.resource.data.summary.diff(resource.data.summary).affectedKeys().hasOnly(['closed']))
        );
      // Draft/open periods may be deleted by admin; a CLOSED accounting period must be reopened first.
      allow delete: if isAdmin() && closedOf(resource.data) == null;
      match /chunks/{chunk} {
        allow read: if canRead();
        // Normal chunks are mutable only while OPEN. For CLOSED -> OPEN, admin may stage only
        // the new content-addressed closed-state blob needed by the REOPEN revision.
        allow create, update: if (canWrite() && periodOpen(period))
          || (isAdmin() && !periodOpen(period) && chunk.matches('closed@.*'));
        allow delete: if isAdmin() && periodOpen(period);
      }
      // Immutable manifest snapshot for every committed cloud revision.
      match /revisions/{revision} {
        allow read: if canRead();
        allow create: if canWrite() && request.resource.data.by == myEmail()
          && request.resource.data.period == period
          && request.resource.data.rev == getAfter(periodPath(period)).data.rev
          && request.resource.data.previousRev == request.resource.data.rev - 1
          && request.resource.data.manifestHash == getAfter(periodPath(period)).data.manifestHash;
        allow update, delete: if false;
      }
    }
    // Append-only audit trail: anyone who can write data can add own events; nobody can change or delete them.
    match /svl_costing_audit/{id} {
      allow read: if canRead();
      allow create: if canWrite() && request.resource.data.by == myEmail();
      allow update, delete: if false;
    }
  }
}
